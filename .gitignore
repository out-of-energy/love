# Compiled binary
/love
/love.exe

# Your personal word file is data, not source. It lives in ~/.ewh/ and must
# never be committed, even if you point EWH_CACHE at this directory.
*.jsonl
!testdata/**/*.jsonl

# The curated morphology tables are the exception to that rule, and the reason
# the rule is written at all: they are source. The affix and override tables
# compile into the binary, and the gold set is a test fixture, so a clone that
# was missing them would not build. What must stay out is the *downloaded*
# Wiktionary index, which lives in ~/.ewh/lexicon/ and carries CC BY-SA.
!internal/lexicon/*.jsonl
!internal/lexicon/testdata/*.jsonl

# Write lock sidecar files
*.lock

# macOS
.DS_Store
